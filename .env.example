# Postgres (Neon or Supabase)
# DATABASE_URL: pooled connection, used by the app at runtime
# DIRECT_URL: non-pooled (session) connection, used by Prisma Migrate
DATABASE_URL="postgresql://user:password@localhost:5432/pagebuilder?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/pagebuilder?schema=public"

# Auth.js
AUTH_SECRET="generate-with-npx-auth-secret"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Comma-separated emails allowed into /admin
ADMIN_EMAILS=""

# Cloudinary, image uploads
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Resend, login and lead notification emails
RESEND_API_KEY=""

# Paystack, billing
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""
# Plan codes created in the Paystack dashboard, one per tier and billing interval
PAYSTACK_PRO_MONTHLY_PLAN_CODE=""
PAYSTACK_PRO_YEARLY_PLAN_CODE=""
PAYSTACK_BUSINESS_MONTHLY_PLAN_CODE=""
PAYSTACK_BUSINESS_YEARLY_PLAN_CODE=""
# Webhook is shared with another app on this Paystack business (only one URL allowed);
# events that aren't Page Builder's forward here untouched.
PAYSTACK_WEBHOOK_FORWARD_URL=""

# Vercel, custom domain verification (Domains API)
VERCEL_API_TOKEN=""
VERCEL_PROJECT_ID=""
VERCEL_TEAM_ID=""

# Full site URL, used to build Paystack's payment callback link
NEXT_PUBLIC_APP_URL="http://localhost:3000"
