// Prisma schema for the Page Builder app.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth.js ────────────────────────────────────────────────────────────
// Shapes required by @auth/prisma-adapter: https://authjs.dev/getting-started/adapters/prisma

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?

  accounts      Account[]
  sessions      Session[]
  sites         Site[]
  subscription  Subscription?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Product models ────────────────────────────────────────────────────

model Site {
  id                String   @id @default(cuid())
  userId            String
  name              String
  slug              String   @unique
  customDomain      String?  @unique
  faviconUrl        String?
  metaTitle         String?
  metaDescription   String?
  ogImageUrl        String?
  isPublished       Boolean  @default(false)
  publishedAt       DateTime?
  theme             Json // colours, fonts, spacing scale

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  blocks Block[]
  leads  Lead[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

enum BlockType {
  HERO
  TEXT
  IMAGE
  GALLERY
  FEATURES
  TESTIMONIALS
  PRICING
  FAQ
  CTA
  CONTACT_FORM
  WHATSAPP_BUTTON
  VIDEO_EMBED
  SOCIAL_LINKS
  FOOTER
  SPACER
}

model Block {
  id        String    @id @default(cuid())
  siteId    String
  type      BlockType
  content   Json
  settings  Json
  sortOrder Int

  site  Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)
  leads Lead[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([siteId, sortOrder])
}

model Lead {
  id          String   @id @default(cuid())
  siteId      String
  blockId     String
  data        Json
  submittedAt DateTime @default(now())
  ipHash      String

  site  Site  @relation(fields: [siteId], references: [id], onDelete: Cascade)
  block Block @relation(fields: [blockId], references: [id], onDelete: Cascade)

  @@index([siteId, submittedAt])
}

enum SubscriptionPlan {
  FREE
  PRO
  BUSINESS
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
}

model Subscription {
  id                          String             @id @default(cuid())
  userId                      String             @unique
  paystackCustomerCode        String?
  paystackSubscriptionCode    String?
  plan                        SubscriptionPlan   @default(FREE)
  status                      SubscriptionStatus @default(ACTIVE)
  currentPeriodEnd            DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
